{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-guru.global/schema/chronicle.schema.json",
  "title": "AI GURU Chronicle Event",
  "type": "object",
  "required": [
    "uid",
    "date",
    "title"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "pattern": "^event/"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "year": {
      "type": "string"
    },
    "cat": {
      "type": "string"
    },
    "cats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object"
    }
  }
}
