{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-guru.global/schema/dataset.schema.json",
  "title": "AI GURU Dataset Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "asOf",
    "license",
    "counts"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "nameZh": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "license": {
      "type": "object"
    },
    "citation": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "files": {
      "type": "object"
    }
  }
}
