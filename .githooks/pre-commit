#!/usr/bin/env bash
# pre-commit hook: 阻止同步工具产生的重复文件入库
# 防护 "* 2.ext"、"*conflicted copy*"、"*.copy.md" 等垃圾文件
# 安装：git config core.hooksPath .githooks

set -e

# 检查暂存区是否含重复文件名模式
dupes=$(git diff --cached --name-only --diff-filter=A | grep -E ' 2\.(md|json|txt|pdf|svg|html|xml)$|conflicted copy|\.copy\.md$' || true)

if [ -n "$dupes" ]; then
  echo "❌ 检测到同步工具产生的重复文件，已阻止提交：" >&2
  echo "$dupes" >&2
  echo "" >&2
  echo "这些文件是 iCloud/编辑器自动产生的副本，与原始文件内容相同。" >&2
  echo "请删除后重新提交。如确需提交，用 git commit --no-verify 绕过。" >&2
  exit 1
fi

exit 0
