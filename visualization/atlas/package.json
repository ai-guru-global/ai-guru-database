{
  "name": "ai-guru-knowledge-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "sync:public": "node ./scripts/sync-public.mjs",
    "dev": "node ./scripts/sync-public.mjs && vite",
    "build": "node ./scripts/sync-public.mjs && tsc -p tsconfig.json && vite build",
    "preview": "node ./scripts/sync-public.mjs && vite preview",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "docs:pdf": "node ./scripts/generate-style-guide-pdf.mjs",
    "demo:record": "node ./scripts/record-demo.mjs",
    "perf:lhci": "lhci autorun"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.53.0",
    "@types/d3": "^7.4.3",
    "sass": "^1.77.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
